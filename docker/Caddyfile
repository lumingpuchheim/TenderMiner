# TLS in front of the app — doc/APP.md 9, doc/HOSTING.md §2 no. 5.
#
# Caddy terminates TLS; the app itself never faces the internet. With a real
# domain set (TM_DOMAIN=app.murara.eu) Caddy fetches and renews Let's Encrypt
# certificates by itself. Without one — the domain is deferred, HOSTING.md §1 —
# it falls back to ":443" with an internal self-signed certificate, so the
# stack is testable end-to-end on a bare IP today and the switch to the real
# domain is one environment variable, no config edit.

{$TM_DOMAIN::443} {
	encode gzip

	# HSTS. Deliberately NOT preload and a moderate max-age until the real
	# domain has served TLS for a while — preload is near-irreversible.
	header Strict-Transport-Security "max-age=2592000"

	# The app sets its own security headers (noindex, CSP, referrer) —
	# Caddy adds nothing content-shaped, so there is exactly one place
	# where those decisions live: app.py.
	reverse_proxy app:8000
}

# The public site (operator decision 2026-08-15: served from this box rather
# than a separate static host — the weekly cycle writes /data/public and Caddy
# serves it, so the trade pages are live the moment they regenerate, no
# publish step). LAUNCH.md §4.1's properties are kept: static files, zero
# forms, zero backend — the app container is not involved, and unlike the app
# block above this one is public-by-design: indexable, no tokens anywhere.
#
# Guarded like the app block: unset TM_WWW_DOMAIN (the laptop; a bare-IP
# test server) collapses this to a loopback-only plain-HTTP site, so Caddy is
# never left retrying certificates for a name whose DNS points elsewhere.
{$TM_WWW_DOMAIN:http://localhost:8099} {
	encode gzip
	header Strict-Transport-Security "max-age=2592000"
	root * /srv/public
	file_server
}
