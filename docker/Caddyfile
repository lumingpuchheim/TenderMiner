# TLS in front of the app — doc/APP.md 9, doc/HOSTING.md §2 no. 5.
#
# Caddy terminates TLS; the app itself never faces the internet. With a real
# domain set (TM_DOMAIN=app.murara.eu) Caddy fetches and renews Let's Encrypt
# certificates by itself. Without one — the domain is deferred, HOSTING.md §1 —
# it falls back to ":443" with an internal self-signed certificate, so the
# stack is testable end-to-end on a bare IP today and the switch to the real
# domain is one environment variable, no config edit.

{$TM_DOMAIN::443} {
	encode gzip

	# HSTS. Deliberately NOT preload and a moderate max-age until the real
	# domain has served TLS for a while — preload is near-irreversible.
	header Strict-Transport-Security "max-age=2592000"

	# The operator's page (doc/ADMIN.md 5). Basic auth lives HERE, not in
	# the app: the app has no login by design, and the one page that writes
	# personal data on our say-so is gated by the edge that already
	# terminates TLS. The app additionally refuses /admin unless this header
	# is present — the app port is loopback-bound, so nothing else can set
	# it, and an edge without this block hides the page instead of exposing
	# it.
	#
	# The credential is IMPORTED FROM A FILE, not read from the
	# environment (doc/ADMIN.md §5c). An environment variable is a copy
	# handed to the process at birth: with `{$TM_ADMIN_HASH}` the password
	# in force was whatever admin.env said the last time the container was
	# CREATED, so a `set` could sit in the file unapplied until the next
	# deploy happened to recreate the edge — and then the browser asked
	# for a password the operator had changed half an hour earlier
	# (2026-08-18). Caddy re-reads this file on every `caddy reload`, so
	# the file is the only truth and putting a new password in force is a
	# reload, not a restart.
	#
	# /etc/murara/caddy.d/admin.caddy holds ONE line, `<user> <bcrypt>`,
	# written by `bash docker/admin-password.sh set` (doc/ADMIN.md §5).
	# The glob is deliberate: no file (a laptop, a fresh server) matches
	# nothing, the block stays empty and /admin answers 401 to EVERY
	# password while the edge starts normally — measured, not assumed.
	# A malformed file is refused by `caddy reload`, which keeps serving
	# the config it already has; only a container recreate can be taken
	# down by one, which is why the writer validates before it reloads.
	@admin path /admin /admin/*
	basic_auth @admin {
		import /etc/caddy/secrets/admin*.caddy
	}
	handle @admin {
		reverse_proxy app:8000 {
			header_up X-Murara-Admin "1"
		}
	}

	# The app sets its own security headers (noindex, CSP, referrer) —
	# Caddy adds nothing content-shaped, so there is exactly one place
	# where those decisions live: app.py. The header a request might carry
	# from outside is stripped: only the block above may set it.
	handle {
		reverse_proxy app:8000 {
			header_up -X-Murara-Admin
		}
	}
}

# The public site (operator decision 2026-08-15: served from this box rather
# than a separate static host — every deploy and every weekly cycle write
# /data/public and Caddy serves it, so the trade pages are live the moment
# they regenerate, no publish step). LAUNCH.md §4.1's properties are kept:
# static files, zero forms, zero backend — the app container is not involved,
# and unlike the app block above this one is public-by-design: indexable, no
# tokens anywhere.
#
# The root is /srv/public/current, a symlink the builder repoints atomically
# at the one complete build beside it (trade_pages.release). Serving `current`
# rather than /srv/public is what makes a rebuild all-or-nothing from here:
# the mount is /srv/public and is never deleted, the link flips in one
# rename, and the previous build is removed once the link has moved.
#
# Guarded like the app block: unset TM_WWW_DOMAIN (the laptop; a bare-IP
# test server) collapses this to a loopback-only plain-HTTP site, so Caddy is
# never left retrying certificates for a name whose DNS points elsewhere.
{$TM_WWW_DOMAIN:http://localhost:8099} {
	encode gzip
	header Strict-Transport-Security "max-age=2592000"
	root * /srv/public/current
	file_server
}
