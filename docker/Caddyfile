# TLS in front of the app — doc/APP.md 9, doc/HOSTING.md §2 no. 5.
#
# Caddy terminates TLS; the app itself never faces the internet. With a real
# domain set (TM_DOMAIN=app.example.de) Caddy fetches and renews Let's Encrypt
# certificates by itself. Without one — the domain is deferred, HOSTING.md §1 —
# it falls back to ":443" with an internal self-signed certificate, so the
# stack is testable end-to-end on a bare IP today and the switch to the real
# domain is one environment variable, no config edit.

{$TM_DOMAIN::443} {
	encode gzip

	# HSTS. Deliberately NOT preload and a moderate max-age until the real
	# domain has served TLS for a while — preload is near-irreversible.
	header Strict-Transport-Security "max-age=2592000"

	# The app sets its own security headers (noindex, CSP, referrer) —
	# Caddy adds nothing content-shaped, so there is exactly one place
	# where those decisions live: app.py.
	reverse_proxy app:8000
}
