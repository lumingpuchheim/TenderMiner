# TenderMining server environment — doc/OPERATIONS.md 4 step 4.
#
# Copy to `.env` NEXT TO docker-compose.yml on the server; compose reads it
# automatically. `.env` is gitignored and must stay that way: two of these are
# live credentials.
#
#   cp .env.example .env && nano .env
#
# This file is the answer to "the machine is gone, what do I have to retype".
# Every value below lives in the operator's password manager; none of them live
# in git. Values shown are the defaults that apply when the line is absent.

# ---------------------------------------------------------------- required

# Where the state directory is on the HOST. Compose bind-mounts it to /data.
# Default ./data (the checkout) is right for the laptop; on the server point it
# somewhere that is not inside a git checkout a deploy hard-resets.
TM_STATE=/srv/tendermining/data

# The operator's legal identity, shown on /impressum (§5 TMG). The page renders
# a visible gap until this is set — deliberately, rather than plausibly fake.
# A public German site may not go live without it.
TM_IMPRESSUM=

# ---------------------------------------------------------------- secrets

# Resend API key. Without it the app records a signup and prints that no mail
# could be sent — it does not fail, and it does not silently pretend to send.
RESEND_API_KEY=

# The verified sending identity at Resend. Unverified domain = every send is
# refused by the API (doc/HOSTING.md 4).
TM_MAIL_FROM=Murara <post@murara.eu>

# ---------------------------------------------------------------- optional

# Which day the container thinks it is. The download window and every dated
# receipt depend on it; a UTC container shifts them by hours and, once a day,
# by a whole date.
TM_TZ=Europe/Bucharest

# The embedding model. A change here is a new sidecar directory and a full
# re-embed, never an in-place mutation (embed.py) — flip it for the whole cycle
# or not at all.
EMBED_MODEL=jina-v2-base-de

# Published port for the app. Behind Caddy this stays on loopback; only the
# edge service should hold 80/443.
TM_APP_PORT=8000

# The domain Caddy gets a certificate for. Empty = self-signed on :443, which
# is enough to test the whole path on a bare IP before the domain decision.
TM_DOMAIN=

# Which image tag runs. Set per-command by docker/deploy.sh — do not pin it
# here, or a deploy would switch the tag and compose would ignore it.
# TM_TAG=

# ------------------------------------------------- not wired up yet (§3)
#
# The nightly restic push of doc/OPERATIONS.md 3. Listed now so the dead-machine
# runbook is complete the day it is written, and because RESTIC_PASSWORD is the
# one secret without which the disaster copy is unreadable — it must live in the
# password manager and never only on the machine it protects.
# RESTIC_REPOSITORY=s3:s3.pub1.infomaniak.cloud/murara-backup
# RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
