# TenderMining server environment — doc/OPERATIONS.md 4 step 4.
#
# Copy to `.env` NEXT TO docker-compose.yml on the server; compose reads it
# automatically. `.env` is gitignored and must stay that way: two of these are
# live credentials.
#
#   cp .env.example .env && nano .env
#
# This file is the answer to "the machine is gone, what do I have to retype".
# Every value below lives in the operator's password manager; none of them live
# in git. Values shown are the defaults that apply when the line is absent.

# ---------------------------------------------------------------- required

# Where the state directory is on the HOST. Compose bind-mounts it to /data.
# Default ./data (the checkout) is right for the laptop; on the server point it
# somewhere that is not inside a git checkout a deploy hard-resets.
TM_STATE=/srv/tendermining/data

# OVERRIDE ONLY — normally empty. The legal identity (§5 TMG) has one source,
# site/impressum/index.html, shipped in the image; app.py's /impressum reads
# it from there. Set this only for a deployment that wants to keep the
# identity out of the repository ("|"-separated lines). Empty is not a gap
# (an audit on 2026-08-15 read the old wording here as one; it was not).
TM_IMPRESSUM=

# ---------------------------------------------------------------- secrets

# Resend API key. Without it the app records a signup and prints that no mail
# could be sent — it does not fail, and it does not silently pretend to send.
RESEND_API_KEY=

# The verified sending identity at Resend. Unverified domain = every send is
# refused by the API (doc/HOSTING.md 4).
TM_MAIL_FROM=Murara <post@murara.eu>

# The price line on the yes-page (/y/, doc/ONBOARDING.md 9.5), e.g.
# "179 € im Monat, monatlich kündbar". Unset until the price is decided: the
# page then says no payment obligation arises from the click.
TM_PRICE_LINE=

# The Stripe payment link shown after the yes. Unset = the customer reads
# "wir melden uns" and the operator gets a mail at info@murara.eu.
TM_STRIPE_URL=

# The operator's page /admin (doc/ADMIN.md 5) is NOT configured here: its
# credential is the edge's alone and lives in /etc/murara/env.d/admin.env
# (doc/SECRETS.md 1). Set it with:
#     TM_SERVER=<host> bash docker/admin-password.sh set
# Unset, the page answers 401 forever (the edge still starts — see the
# compose file's placeholder).

# ---------------------------------------------------------------- optional

# The operator's A/B overview page, /experiments/<this value> (doc/EXPERIMENTS.md
# §9). An UNLISTED URL, not authentication: generate once with
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# and keep it out of any link a customer sees. Empty = the route does not exist.
# Configuration, not a credential — not one of SECRETS.md's four.
TM_EXPERIMENTS_KEY=

# Which day the container thinks it is. The download window and every dated
# receipt depend on it; a UTC container shifts them by hours and, once a day,
# by a whole date.
TM_TZ=Europe/Bucharest

# The embedding model. A change here is a new sidecar directory and a full
# re-embed, never an in-place mutation (embed.py) — flip it for the whole cycle
# or not at all.
EMBED_MODEL=jina-v2-base-de

# Published port for the app. Behind Caddy this stays on loopback; only the
# edge service should hold 80/443.
TM_APP_PORT=8000

# The domain Caddy gets a certificate for. Empty = self-signed on :443, which
# is enough to test the whole path on a bare IP before the domain decision.
TM_DOMAIN=

# The public brochure site (www), served by the edge from /data/public where
# the weekly cycle writes it. Empty = no www site (a loopback placeholder),
# so a test server never fights Let's Encrypt over a name that points
# elsewhere. Set together with the www DNS records.
TM_WWW_DOMAIN=

# Which image tag runs. Set per-command by docker/deploy.sh — do not pin it
# here, or a deploy would switch the tag and compose would ignore it.
# TM_TAG=

# --------------------------------------------- the nightly off-site backup
#
# doc/OPERATIONS.md 3 layer 2, run by docker/nightly.sh at 02:30. Until these
# four are filled the backup runs in local-only mode and says so in the cron
# log every night — filling them is what turns on the disaster copy. The
# bucket belongs at whichever provider does NOT host this VPS. RESTIC_PASSWORD
# is the one secret without which that copy is unreadable: password manager,
# never only on the machine it protects.
# RESTIC_REPOSITORY=s3:s3.pub1.infomaniak.cloud/murara-backup
# RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
