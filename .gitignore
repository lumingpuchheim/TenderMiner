# Downloaded notice data — re-fetch with the scripts, never commit.
# The built public site lives here too, at data/public/: `site/` is the
# hand-written source, the generated trade pages are never committed
# (doc/TRADE_PAGES.md 6).
data/

# Guard against an older command writing the generated pages back into the
# checkout — in the container that path is the read-only image.
site/gewerke/
site/sitemap.xml
*.zip

# The server's environment file — holds the Resend key and the restic password
# (.env.example is the committed template, doc/OPERATIONS.md 4 step 4). Compose
# picks .env up automatically, which is exactly why it must never be committable.
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Model registry and CatBoost training scratch — on-disk artifacts, never committed
models/
catboost_info/
