# -> /etc/murara/env.d/payments.env  (laptop working copy: ~/.murara/env.d/payments.env)
# Stripe (doc/PAYMENT.md; the file is named for the issuer, SECRETS.md 1).
# Durable copy: the password manager, note "murara/payments.env".
# Move with `bash docker/secrets.sh push payments.env`, never through git.
# sk_test_… keys hit Stripe test mode, sk_live_… real money — same code.
STRIPE_SECRET_KEY=
# From the webhook endpoint's page in the Stripe dashboard ("signing
# secret", whsec_…). Without it every webhook is refused as unsigned.
STRIPE_WEBHOOK_SECRET=
