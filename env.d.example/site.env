# -> /etc/murara/env.d/site.env  (laptop working copy: ~/.murara/env.d/site.env)
# Per-machine configuration, none of it secret (doc/SECRETS.md 1). May be
# pasted into a chat without harm; still not in git because the laptop has
# no domain. Move with `bash docker/secrets.sh push site.env`.
TM_SALES_OWNER=
# The verified sending identity at Resend — an unverified domain means every
# send is refused by the API (doc/HOSTING.md 4).
TM_MAIL_FROM=Murara <info@murara.eu>
# Global price override (mailer.price_line; default "79 € im Monat" in code).
TM_PRICE_LINE=
# The Stripe PRICE the checkout charges (doc/PAYMENT.md): price_… from the
# product in the Stripe dashboard. An id, not a secret — but per machine
# (test mode on the laptop, live on the server), hence here and not in git.
TM_STRIPE_PRICE_ID=
