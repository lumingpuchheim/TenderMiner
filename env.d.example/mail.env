# -> /etc/murara/env.d/mail.env  (laptop working copy: ~/.murara/env.d/mail.env)
# The Resend API key (doc/SECRETS.md 1 — the file is named for the issuer).
# Durable copy: the password manager, note "murara/mail.env" (the whole file).
# Move with `bash docker/secrets.sh push mail.env`, never through git or .env.
RESEND_API_KEY=
